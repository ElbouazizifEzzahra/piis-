APP_NAME=PIIS Backend
ENV=dev

# --- POSTGRES DOCKER VARIABLES ---
# Used by the Postgres container at startup
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=piis_db

# --- FASTAPI VARIABLES ---
DATABASE_URL=postgresql://postgres:change-me@db:5432/piis_db

# --- SECURITY ---
SECRET_KEY=replace-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CLOUDINARY IMAGE STORAGE ---
# Keep placeholders for local setup if Cloudinary is not used yet
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=dummy
CLOUDINARY_API_SECRET=dummy
